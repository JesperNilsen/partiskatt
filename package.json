{
  "name": "partiskatt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hvor mye mer eller mindre sitter du igjen med under hvert partis alternative statsbudsjett 2026?",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "data-status": "tsx scripts/gen-data-status.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "check": "npm run typecheck && npm run test && npm run reconcile -- --check && npm run data-status -- --check && npm run build"
  },
  "dependencies": {
    "marked": "^14.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
